{
  "name": "devflow",
  "version": "1.2.0",
  "description": "A high-performance build system and local dev-server with livereload for custom-code-heavy Webflow projects.",
  "author": "Virat Patel, Lukas Manuel Graf",
  "license": "MIT",
  "private": false,
  "type": "module",
  "bin": {
    "devflow": "./dist/cli.js"
  },
  "scripts": {
    "dev": "nodemon",
    "build": "npm run --silent build:cli && npm run --silent build:extension",
    "build:cli": "tsx ./scripts/build-cli.ts",
    "build:extension": "tsx ./scripts/build-extension.ts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/chrome": "^0.1.38",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/yargs": "^17.0.24",
    "esbuild-plugin-vue3": "^0.5.1",
    "esbuild-postcss": "^0.0.4",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.0.4",
    "vue-tsc": "^3.2.8"
  },
  "dependencies": {
    "@types/express-ws": "^3.0.1",
    "axios": "^1.4.0",
    "chalk": "^5.6.0",
    "chokidar": "^4.0.3",
    "commander": "^14.0.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "esbuild": "^0.25.9",
    "express": "^4.18.2",
    "express-ws": "^5.0.2",
    "loglevel": "^1.9.2",
    "peakflow": "github:peakpointch/peakflow#9ad7051",
    "strip-ansi": "^7.1.0",
    "vue": "^3.5.31",
    "zod": "^3.21.4"
  }
}
