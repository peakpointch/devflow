{
  "name": "peakflow-cli",
  "version": "0.1.0",
  "description": "A high-performance build system and local dev-server with livereload for custom-code-heavy Webflow projects.",
  "author": "Lukas Manuel Graf, Virat Patel",
  "license": "MIT",
  "private": false,
  "type": "module",
  "bin": {
    "peakflow": "./dist/cli.js"
  },
  "scripts": {
    "build": "npm run --silent build:cli && npm run --silent build:extension",
    "build:dev": "npm run --silent build:cli:dev && npm run --silent build:extension:dev",
    "build:cli": "tsx ./scripts/build-cli.ts",
    "build:cli:dev": "tsx ./scripts/build-cli.ts --env development",
    "build:extension": "tsx ./scripts/build-extension.ts",
    "build:extension:dev": "tsx ./scripts/build-extension.ts --env development",
    "test": "node --disable-warning=ExperimentalWarning --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:verbose": "node --disable-warning=ExperimentalWarning --experimental-vm-modules ./node_modules/jest/bin/jest.js --verbose",
    "test:watch": "node --disable-warning=ExperimentalWarning --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chrome": "^0.1.38",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.13",
    "@types/degit": "^2.8.6",
    "@types/express": "^4.17.17",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/yargs": "^17.0.24",
    "esbuild-plugin-vue3": "^0.5.1",
    "esbuild-postcss": "^0.0.4",
    "jest": "^30.4.2",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.11",
    "type-fest": "^5.8.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.2.8"
  },
  "dependencies": {
    "@types/express-ws": "^3.0.1",
    "axios": "^1.4.0",
    "better-auth": "^1.6.23",
    "chalk": "^5.6.0",
    "chokidar": "^4.0.3",
    "commander": "^14.0.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "express": "^4.18.2",
    "express-ws": "^5.0.2",
    "fs-extra": "^11.3.5",
    "giget": "^3.3.0",
    "loglevel": "^1.9.2",
    "peakflow": "github:peakpointch/peakflow#main",
    "string-width": "^8.2.2",
    "vue": "^3.5.31",
    "webflow-api": "^3.3.4",
    "zod": "^3.21.4"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "core-js@3.50.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.27.2": true
  }
}
